{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AppConfig": {
    "Endpoint": "https://appconfig-jobforge-dev.azconfig.io"
  },
  "ServiceBus": {
    "Namespace": "sbns-jobforge-dev.servicebus.windows.net",
    "TopicName": "job-events",
    "SubscriptionName": "indexer-sub"
  },
  "Search": {
    "Endpoint": "https://jobforge-search-dev.search.windows.net",
    "IndexName": "jobs-index"
  },
  "IndexerSettings": {
    "MaxConcurrentCalls": 10,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 30,
    "BatchSize": 100
  }
}
