# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# .NET files
[*.{cs,csproj}]
indent_size = 4
end_of_line = lf

# TypeScript/JavaScript files
[*.{ts,tsx,js,jsx,json}]
indent_size = 2
end_of_line = lf

# Markdown files
[*.md]
indent_size = 2
trim_trailing_whitespace = false
end_of_line = lf

# YAML files
[*.{yml,yaml}]
indent_size = 2
end_of_line = lf

# Bicep files
[*.bicep]
indent_size = 2
end_of_line = lf

# HTML files
[*.html]
indent_size = 2
end_of_line = lf
