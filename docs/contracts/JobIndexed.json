{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jobforge.io/schemas/events/JobIndexed.json",
  "title": "JobIndexed",
  "description": "Event published when a normalized job is indexed in the search system",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "timestamp",
    "source",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event"
    },
    "eventType": {
      "type": "string",
      "const": "JobIndexed",
      "description": "Type of event"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was created"
    },
    "source": {
      "type": "string",
      "description": "Source system that published this event (e.g., indexer-worker)"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Correlation ID for tracing across services"
    },
    "data": {
      "type": "object",
      "required": [
        "jobId",
        "indexName",
        "indexedAt"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "description": "Unique identifier for the job"
        },
        "indexName": {
          "type": "string",
          "description": "Name of the search index (e.g., jobs-index)"
        },
        "indexedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the job was indexed"
        },
        "searchScore": {
          "type": "number",
          "description": "Optional initial search score"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata for search optimization",
          "properties": {
            "skills": {
              "type": "array",
              "items": { "type": "string" }
            },
            "categories": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
